<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="16dp">

    <!-- Add a scroll view to ensure content fits on smaller screens -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Profile Header Section with improved styling -->
            <LinearLayout
                android:id="@+id/profile_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingBottom="24dp">

                <!-- Profile Image with circular frame -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profile_image"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Profile Image"
                    app:strokeColor="@android:color/white"
                    app:strokeWidth="2dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.LumeW.Circle"/>

                <!-- Name with DIN Black Alternate font -->
                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="24sp"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/din_black_alternate"
                    tools:text="John Doe" />

                <!-- Username with DIN Light font -->
                <TextView
                    android:id="@+id/profile_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="16sp"
                    android:textColor="#CCCCCC"
                    android:fontFamily="@font/din_light"
                    tools:text="/@johndoe" />

                <!-- Bio with DIN Light font -->
                <TextView
                    android:id="@+id/profile_bio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="#BBBBBB"
                    android:fontFamily="@font/din_light"
                    tools:text="This is my bio description" />

                <!-- Movie Count with DIN Medium font -->
                <TextView
                    android:id="@+id/profile_movie_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/din_medium"
                    tools:text="125 movies" />

                <!-- Edit Profile Button with modern styling -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Edit Profile"
                    android:textAllCaps="false"
                    android:fontFamily="@font/din_medium"
                    app:cornerRadius="24dp"
                    app:strokeColor="@android:color/white"
                    app:strokeWidth="1dp"
                    android:backgroundTint="#333333"
                    android:textColor="@android:color/white" />

                <!-- Sign In Button (for unauthenticated users) with modern styling -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sign_in"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Sign In"
                    android:textAllCaps="false"
                    android:fontFamily="@font/din_medium"
                    app:cornerRadius="24dp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#000000"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Library Section Header with card background -->
            <androidx.cardview.widget.CardView
                android:id="@+id/library_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/profile_header"
                app:cardBackgroundColor="#161616"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/library_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Library"
                    android:textSize="20sp"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/din_black_alternate"
                    android:padding="16dp" />
            </androidx.cardview.widget.CardView>

            <!-- RecyclerView for Movie Library with improved styling -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/profile_library_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/library_card"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="80dp"
                tools:listitem="@layout/item_movie" />
        </RelativeLayout>
    </ScrollView>

    <!-- Progress Bar with white color -->
    <ProgressBar
        android:id="@+id/profile_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="@android:color/white"
        android:visibility="gone" />

    <!-- Settings FAB with modern styling -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:contentDescription="Settings"
        app:backgroundTint="#DE942C"
        app:tint="@android:color/white"
        app:borderWidth="1dp"
        app:srcCompat="@android:drawable/ic_menu_manage" />

</RelativeLayout>