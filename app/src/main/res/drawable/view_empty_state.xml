<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Empty State Icon -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="Empty state icon"
        android:src="@drawable/view_empty_state"
        android:tint="@color/on_surface_variant"
        tools:ignore="ResourceCycle" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="No Movies Found"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/din_medium" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="We couldn't find any movies. Try refreshing or check your connection."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="@font/din_light" />

    <!-- Action Button (Optional) -->
    <Button
        android:id="@+id/empty_state_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Try Again"
        android:textColor="@color/primary"
        android:backgroundTint="@color/surface"
        android:fontFamily="@font/din_medium"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>