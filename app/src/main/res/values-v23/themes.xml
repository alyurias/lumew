<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - now using MaterialComponents -->
    <style name="Theme.LumeW" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Background/surface colors -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Status/navigation bars -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Typography -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.LumeW.Display.Large</item>
        <item name="textAppearanceBody1">@style/TextAppearance.LumeW.Body.Large</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.LumeW.Title.Medium</item>

        <!-- Component shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.LumeW.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.LumeW.Medium</item>

        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Button.LumeW</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.LumeW.Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/logo</item>
        <item name="postSplashScreenTheme">@style/Theme.LumeW</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
    </style>

    <!-- Text appearances -->
    <style name="TextAppearance.LumeW.Display.Large" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="fontFamily">@font/din_medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.LumeW.Body.Large" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/din_light</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.LumeW.Title.Medium" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/din_medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Shape appearances -->
    <style name="ShapeAppearance.LumeW.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.LumeW.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Button style -->
    <style name="Button.LumeW" parent="Widget.MaterialComponents.Button">
        <item name="android:textAppearance">@style/TextAppearance.LumeW.Body.Large</item>
        <item name="android:minHeight">48dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LumeW.Medium</item>
        <item name="backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/black</item>
    </style>
</resources>